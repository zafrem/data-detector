{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://data-detector.io/schemas/pattern-schema.json",
  "title": "Data Detector Pattern Schema",
  "description": "Schema for data-detector pattern definition files",
  "type": "object",
  "required": ["namespace", "patterns"],
  "properties": {
    "namespace": {
      "type": "string",
      "pattern": "^[a-z]{2,4}$",
      "description": "Namespace identifier: ISO2 country code (e.g., kr, us, jp) or special identifier (e.g., comm)"
    },
    "description": {
      "type": "string",
      "description": "Description of this pattern namespace"
    },
    "patterns": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/definitions/pattern"
      }
    }
  },
  "definitions": {
    "pattern": {
      "type": "object",
      "required": ["id", "location", "category", "pattern"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z_][a-z0-9_]+$",
          "description": "Unique identifier within namespace (e.g., mobile_01, ssn_01, swift_bic)"
        },
        "location": {
          "type": "string",
          "pattern": "^[a-z]{2,4}$",
          "description": "Location/region identifier (e.g., kr, us, comm)"
        },
        "category": {
          "type": "string",
                    "enum": [
                      "phone",
                      "ssn",
                      "rrn",
                      "email",
                      "bank",
                      "passport",
                      "address",
                      "credit_card",
                      "ip",
                      "name",
                      "iban",
                      "location",
                      "token",
                      "date_of_birth",
                      "identification",
                      "financial",
                      "medical",
                      "other"
                    ],
          "description": "Category of personal information"
        },
        "description": {
          "type": "string",
          "description": "Human-readable description of the pattern"
        },
        "pattern": {
          "type": "string",
          "minLength": 1,
          "description": "Regular expression pattern"
        },
        "flags": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": ["IGNORECASE", "MULTILINE", "DOTALL", "UNICODE", "VERBOSE"]
          },
          "description": "Regex flags to apply"
        },
        "mask": {
          "type": "string",
          "description": "Default mask template (e.g., ***-****-****)"
        },
        "verification": {
          "type": "string",
          "description": "Optional verification function name (e.g., 'iban_mod97', 'luhn')"
        },
        "priority": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000,
          "default": 100,
          "description": "Search priority (lower = higher priority, default = 100)"
        },
        "examples": {
          "type": "object",
          "properties": {
            "match": {
              "type": "array",
              "items": {"type": "string"},
              "description": "Examples that should match"
            },
            "nomatch": {
              "type": "array",
              "items": {"type": "string"},
              "description": "Examples that should NOT match"
            }
          }
        },
        "policy": {
          "type": "object",
          "properties": {
            "store_raw": {
              "type": "boolean",
              "default": false,
              "description": "Whether raw matched text can be stored"
            },
            "action_on_match": {
              "type": "string",
              "enum": ["redact", "report", "tokenize", "ignore"],
              "default": "redact",
              "description": "Default action when pattern matches"
            },
            "severity": {
              "type": "string",
              "enum": ["low", "medium", "high", "critical"],
              "default": "medium",
              "description": "Severity level of the PII type"
            }
          }
        },
        "match_type": {
          "type": "string",
          "enum": ["contains", "exactly_matches"],
          "description": "How the pattern should match: 'contains' (default) or 'exactly_matches'"
        },
        "langs": {
          "type": "object",
          "description": "Language-specific regex patterns (python, go, java, javascript)",
          "additionalProperties": {
            "type": "string"
          }
        },
        "metadata": {
          "type": "object",
          "description": "Additional metadata for the pattern",
          "additionalProperties": true
        }
      }
    }
  }
}
